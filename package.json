{
  "name": "beeper-cli-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.10",
  "workspaces": [
    "packages/*"
  ],
  "trustedDependencies": [
    "@beeper/desktop-api"
  ],
  "scripts": {
    "build": "bun run --workspaces --sequential build",
    "check": "bun run test && bun run pack:packages",
    "clean": "bun run --workspaces clean",
    "pack:packages": "mkdir -p .packs && npm pack --workspace beeper-cli --pack-destination .packs",
    "test": "bun run --workspaces --sequential test",
    "typecheck": "bun run --filter beeper-cli build && bun run --workspaces --sequential typecheck"
  }
}
